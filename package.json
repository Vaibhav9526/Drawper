{
  "name": "drawper",
  "displayName": "Drawper",
  "description": "A fast whiteboard canvas inside VS Code with system architecture and database schema panels that generate code (SQL, Prisma, Drizzle, TypeScript, docker-compose). Files use the .dpr extension.",
  "version": "0.0.1",
  "publisher": "tizmoAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vaibhav9526/Drawper.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "drawper.open",
        "title": "Drawper: Open Drawing Canvas",
        "icon": "media/brand/logo.svg"
      },
      {
        "command": "drawper.new",
        "title": "Drawper: New Drawing",
        "icon": "media/brand/logo.svg"
      },
      {
        "command": "drawper.viewSchema",
        "title": "Drawper: View Schema in This File",
        "icon": "media/brand/logo.svg"
      },
      {
        "command": "drawper.convertSchema",
        "title": "Drawper: Convert Schema To…",
        "icon": "media/brand/logo.svg"
      },
      {
        "command": "drawper.addToCanvas",
        "title": "Drawper: Add Selection to Canvas",
        "icon": "media/brand/add.svg"
      },
      {
        "command": "drawper.annotateCode",
        "title": "Drawper: Open Code Canvas",
        "icon": "media/brand/canvas.svg"
      },
      {
        "command": "drawper.toggleOverlay",
        "title": "Drawper: Show or Hide Drawings on Editor"
      }
    ],
    "customEditors": [
      {
        "viewType": "drawper.editor",
        "displayName": "Drawper Canvas",
        "selector": [
          {
            "filenamePattern": "*.dpr"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "drawper",
        "extensions": [
          ".dpr"
        ],
        "aliases": [
          "Drawper"
        ],
        "icon": {
          "light": "media/brand/logo.svg",
          "dark": "media/brand/logo.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "drawper.open",
          "group": "navigation@0"
        },
        {
          "command": "drawper.annotateCode",
          "when": "resourceScheme == file && resourceExtname != .dpr",
          "group": "navigation@2"
        },
        {
          "command": "drawper.addToCanvas",
          "when": "editorHasSelection && resourceScheme == file && resourceExtname != .dpr",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "drawper.new",
          "group": "navigation"
        },
        {
          "command": "drawper.viewSchema",
          "when": "resourceExtname =~ /\\.(prisma|sql|ts|tsx|mts|js|jsx|mjs|cjs|py)$/",
          "group": "navigation@9"
        },
        {
          "command": "drawper.convertSchema",
          "when": "resourceExtname =~ /\\.(prisma|sql|ts|tsx|mts|js|jsx|mjs|cjs|py)$/",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "drawper.viewSchema",
          "when": "resourceExtname =~ /\\.(prisma|sql|ts|tsx|mts|js|jsx|mjs|cjs|py)$/",
          "group": "navigation@9"
        },
        {
          "command": "drawper.convertSchema",
          "when": "resourceExtname =~ /\\.(prisma|sql|ts|tsx|mts|js|jsx|mjs|cjs|py)$/",
          "group": "navigation@10"
        },
        {
          "command": "drawper.annotateCode",
          "when": "resourceScheme == file && resourceExtname != .dpr",
          "group": "navigation@21"
        },
        {
          "command": "drawper.addToCanvas",
          "when": "editorHasSelection && resourceScheme == file && resourceExtname != .dpr",
          "group": "navigation@22"
        }
      ]
    },
    "configuration": {
      "title": "Drawper",
      "properties": {
        "drawper.overlay.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show drawings made on a code canvas over the matching text editor (display only)."
        },
        "drawper.overlay.charWidthRatio": {
          "type": "number",
          "default": 0.6,
          "minimum": 0.4,
          "maximum": 0.8,
          "description": "Width of one editor column as a fraction of the font size. Adjust if drawings drift sideways (Consolas is about 0.55, most other monospace fonts 0.6)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/build-webview.mjs",
    "typecheck:webview": "tsc -p src/webview",
    "watch": "tsc -watch -p ./",
    "watch:webview": "node scripts/build-webview.mjs --watch",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce package",
    "test": "npm run compile && node scripts/test-parsers.mjs && node scripts/test-codegen.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "husky": "^9.1.7",
    "playwright-core": "^1.49.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "icon": "media/brand/logo.png",
  "galleryBanner": {
    "color": "#7c2d12",
    "theme": "dark"
  },
  "homepage": "https://github.com/Vaibhav9526/Drawper#readme",
  "bugs": {
    "url": "https://github.com/Vaibhav9526/Drawper/issues"
  },
  "keywords": [
    "whiteboard",
    "diagram",
    "architecture",
    "database",
    "schema",
    "er diagram",
    "prisma",
    "drizzle",
    "sql",
    "docker-compose",
    "codegen"
  ]
}
